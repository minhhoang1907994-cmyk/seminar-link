<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Seminar Link" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Seminar Link">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <% presenter_layout = content_for?(:presenter_layout) %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <% unless presenter_layout %>
      <%= javascript_importmap_tags %>
    <% end %>
  </head>

  <body class="<%= 'presenter-body' if presenter_layout %>">
    <% unless presenter_layout %>
      <div class="app-container">
        <header class="site-header">
          <%= link_to root_path, class: "site-brand-link", aria: { label: "Về trang chủ" } do %>
            <span class="site-logo-mark" aria-hidden="true">
              <span class="logo-dot"></span>
              <span class="logo-bar"></span>
              <span class="logo-bar short"></span>
            </span>
            <span class="site-brand-text">Seminar Link</span>
          <% end %>
        </header>

        <div class="app-body">
          <aside class="app-sidebar">
            <nav class="sidebar-nav">
              <div class="nav-section">
                <div class="nav-section-title">Tài liệu</div>
                <%= link_to "Tất cả tài liệu", root_path, class: "nav-link #{' active' if current_page?(root_path)}" %>
                <%= link_to "Upload file", new_document_path, class: "nav-link #{' active' if current_page?(new_document_path)}" %>
              </div>
            </nav>
          </aside>

          <main class="site-main">
            <% flash.each do |key, value| %>
              <div class="flash flash-<%= key %>"><%= value %></div>
            <% end %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <%= yield %>
      <%= javascript_importmap_tags %>
    <% end %>
  </body>
</html>